{
  "name": "digitalgdn/oauth2-sheepcrm",
  "description": "SheepCRM OAuth 2.0 support for the PHP League's OAuth 2.0 Client",
  "license": "MIT",
  "authors": [
    {
      "name": "DigitalGdn",
      "homepage": "https://digitalgarden.co"
    }
  ],
  "keywords": [
    "php",
    "sheepcrm",
    "oauth",
    "oauth2",
    "client",
    "authorization",
    "authentication"
  ],
  "require": {
    "php": ">=8.1",
    "league/oauth2-client": "^2.8"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5 || ^11.0"
  },
  "autoload": {
    "psr-4": {
      "DigitalGdn\\OAuth2\\Client\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "DigitalGdn\\OAuth2\\Client\\Test\\": "test/src/"
    }
  },
  "scripts": {
    "test": "phpunit"
  }
}
